{
  "repo_root": "@REPO@",
  "name": "latency-lowres-node1",
  "results_root": "@OUTPUT@",
  "datasets": [
    "MathVision",
    "BabyVision",
    "RealWorldQA",
    "ERQA_SINGLE",
    "CharXiv_reasoning_val"
  ],
  "replay_modes": [
    "image_text",
    "image_text_image_text"
  ],
  "cot_modes": [
    "default"
  ],
  "sampling_fraction": 0.1,
  "batch_size": 1,
  "strict_timing": true,
  "separate_warmup": true,
  "ordered_allowlists": true,
  "initial_image_transform": "v2_tokens_half",
  "recipes": [
    {
      "name": "VT",
      "replay_mode": "image_text",
      "image_transform": "baseline"
    },
    {
      "name": "SLP",
      "replay_mode": "image_text_image_text",
      "image_transform": "baseline"
    },
    {
      "name": "SLP-half",
      "replay_mode": "image_text_image_text",
      "image_transform": "v2_tokens_half"
    },
    {
      "name": "SLP-quarter",
      "replay_mode": "image_text_image_text",
      "image_transform": "v2_tokens_quarter"
    }
  ],
  "parallel_models": true,
  "models": [
    {
      "name": "node1-lane0",
      "path": "@MODEL@",
      "registry": "Qwen3.8-27B-Replay",
      "framework": "qwen",
      "gpu": "0,1",
      "tp": 2,
      "python": "@PYTHON@",
      "overrides": {
        "datasets": [
          "MathVision",
          "BabyVision",
          "RealWorldQA",
          "ERQA_SINGLE",
          "CharXiv_reasoning_val"
        ],
        "dataset_index_allowlists": {
          "MathVision": "{repo_root}/configs/paper/latency/allowlists/qwen38-lane0-MathVision.json",
          "BabyVision": "{repo_root}/configs/paper/latency/allowlists/qwen38-lane0-BabyVision.json",
          "RealWorldQA": "{repo_root}/configs/paper/latency/allowlists/qwen38-lane0-RealWorldQA.json",
          "ERQA_SINGLE": "{repo_root}/configs/paper/latency/allowlists/qwen38-lane0-ERQA_SINGLE.json",
          "CharXiv_reasoning_val": "{repo_root}/configs/paper/latency/allowlists/qwen38-lane0-CharXiv_reasoning_val.json"
        },
        "environment": {
          "VLMEVAL_LAZY_INIT": "1",
          "VLMEVAL_VLM_MINIMAL_IMPORT": "1",
          "VLMEVAL_API_MINIMAL_IMPORT": "1",
          "VLMEVAL_USE_QWEN_MINIMAL_CONFIG": "1",
          "HF_HUB_OFFLINE": "1",
          "TRANSFORMERS_OFFLINE": "1",
          "OMP_NUM_THREADS": "4",
          "TOKENIZERS_PARALLELISM": "false",
          "FORCE_LOCAL": "True",
          "OLD_VERSION": "False",
          "PYTHONNOUSERSITE": "1",
          "LMUData": "@LMUDATA@",
          "HF_HOME": "/path/to/temporary/scratch/prompt-replay/hf-cache",
          "REPLAY_MODE": "image_text_image_text",
          "REPLAY_PROMPT_TEMPLATE_NAME": "identity",
          "REPLAY_IMAGE_TRANSFORM_TARGET_POSITION": "2",
          "QWEN35_NONTHINK_SAMPLING": "greedy",
          "TORCHINDUCTOR_CACHE_DIR": "@CACHE@/lane0/torchinductor_cache_dir",
          "TRITON_CACHE_DIR": "@CACHE@/lane0/triton_cache_dir",
          "VLLM_CACHE_ROOT": "@CACHE@/lane0/vllm_cache_root"
        },
        "worker_id": "node1-lane0",
        "max_new_tokens": 32768,
        "vllm": {
          "max_num_seqs": 16,
          "max_model_len": 40960,
          "gpu_memory_utilization": 0.9
        },
        "expected_sampling": {
          "temperature": 0.0,
          "repetition_penalty": 1.0,
          "max_tokens": 32768,
          "presence_penalty": 1.5
        },
        "startup_barrier": {
          "path": "@OUTPUT@/ready",
          "participants": [
            "node1-lane0",
            "node1-lane1",
            "node1-lane2",
            "node1-lane3"
          ],
          "timeout_seconds": 1800
        }
      }
    },
