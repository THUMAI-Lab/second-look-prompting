# Copy to .env or export these variables before running.

# VLMEvalKit dataset cache (benchmarks are downloaded here on first use).
LMUData=/path/to/LMUData

# Checkpoint directory and the root that holds envs/vlmeval017 and envs/vlmeval031.
MODEL_ROOT=/path/to/models
CONDA_ROOT=/path/to/environments

# Judge endpoint for LLM-scored benchmarks (OpenAI-compatible).
OPENAI_API_KEY_JUDGE=
OPENAI_API_BASE_JUDGE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

PYTHONNOUSERSITE=1
